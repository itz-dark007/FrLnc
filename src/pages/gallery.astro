---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gallery" description="Visual showcase of our electrical projects and services">
  <div class="container">
    <h1 style="color: var(--primary-color); margin-bottom: 2rem; font-size: 2.5rem;">Project Gallery</h1>

    <p class="section-subtitle">Visual documentation of our completed projects and installations across various sectors and scales.</p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin: 2rem 0;">
      <div style="background-color: var(--light-bg); padding: 2rem; border-radius: 8px; text-align: center; min-height: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <h3 style="color: var(--primary-color); margin-bottom: 1rem;">Industrial Panel Installation</h3>
        <p style="color: #666;">[Image Placeholder]</p>
        <p style="font-size: 0.9rem; color: #999; margin-top: 1rem;">Custom electrical panel installation for manufacturing facility</p>
      </div>

      <div style="background-color: var(--light-bg); padding: 2rem; border-radius: 8px; text-align: center; min-height: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <h3 style="color: var(--primary-color); margin-bottom: 1rem;">Commercial Wiring</h3>
        <p style="color: #666;">[Image Placeholder]</p>
        <p style="font-size: 0.9rem; color: #999; margin-top: 1rem;">Complete electrical wiring system for commercial office</p>
      </div>

      <div style="background-color: var(--light-bg); padding: 2rem; border-radius: 8px; text-align: center; min-height: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <h3 style="color: var(--primary-color); margin-bottom: 1rem;">Smart Home Integration</h3>
        <p style="color: #666;">[Image Placeholder]</p>
        <p style="font-size: 0.9rem; color: #999; margin-top: 1rem;">Modern smart home electrical systems installation</p>
      </div>

      <div style="background-color: var(--light-bg); padding: 2rem; border-radius: 8px; text-align: center; min-height: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <h3 style="color: var(--primary-color); margin-bottom: 1rem;">Emergency Backup System</h3>
        <p style="color: #666;">[Image Placeholder]</p>
        <p style="font-size: 0.9rem; color: #999; margin-top: 1rem;">Generator and backup power installation</p>
      </div>

      <div style="background-color: var(--light-bg); padding: 2rem; border-radius: 8px; text-align: center; min-height: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <h3 style="color: var(--primary-color); margin-bottom: 1rem;">Lighting Upgrades</h3>
        <p style="color: #666;">[Image Placeholder]</p>
        <p style="font-size: 0.9rem; color: #999; margin-top: 1rem;">LED lighting upgrade for retail space</p>
      </div>

      <div style="background-color: var(--light-bg); padding: 2rem; border-radius: 8px; text-align: center; min-height: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <h3 style="color: var(--primary-color); margin-bottom: 1rem;">Safety Systems</h3>
        <p style="color: #666;">[Image Placeholder]</p>
        <p style="font-size: 0.9rem; color: #999; margin-top: 1rem;">Fire alarm and safety system installation</p>
      </div>

      <div style="background-color: var(--light-bg); padding: 2rem; border-radius: 8px; text-align: center; min-height: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <h3 style="color: var(--primary-color); margin-bottom: 1rem;">Renewable Energy</h3>
        <p style="color: #666;">[Image Placeholder]</p>
        <p style="font-size: 0.9rem; color: #999; margin-top: 1rem;">Solar panel electrical system integration</p>
      </div>

      <div style="background-color: var(--light-bg); padding: 2rem; border-radius: 8px; text-align: center; min-height: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <h3 style="color: var(--primary-color); margin-bottom: 1rem;">Network Infrastructure</h3>
        <p style="color: #666;">[Image Placeholder]</p>
        <p style="font-size: 0.9rem; color: #999; margin-top: 1rem;">Data center power distribution system</p>
      </div>
    </div>

    <section style="background-color: var(--light-bg); padding: 2rem; border-radius: 8px; margin-top: 4rem; text-align: center;">
      <h2 style="color: var(--primary-color); margin-bottom: 1rem;">Ready to See Your Project Come to Life?</h2>
      <p style="color: #666; margin-bottom: 1.5rem;">Contact us for a consultation and let's discuss your electrical project needs.</p>
      <a href="/contact" class="cta-button">Get Started</a>
    </section>
  </div>
</Layout>
