---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gallery - Sinewy Electrical Solutions" description="Visual showcase of our electrical infrastructure projects">
  <section class="hero">
    <div class="container">
      <h1>PROJECT GALLERY</h1>
      <p>VISUAL DOCUMENTATION OF OUR COMPLETED PROJECTS</p>
    </div>
  </section>

  <div class="container">
    <section>
      <h2 class="section-title">OUR PROJECT PORTFOLIO</h2>
      <p class="subtitle">Explore our collection of successfully completed electrical infrastructure projects across various sectors.</p>

      <div class="gallery-grid" style="margin-top: 3rem;">
        <div class="gallery-item" style="background: linear-gradient(135deg, #c85a17 0%, #1a3a52 100%); display: flex; align-items: center; justify-content: center;">
          <div style="color: white; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">🏢</div>
            <p style="font-weight: 600;">SUBSTATION</p>
          </div>
        </div>

        <div class="gallery-item" style="background: linear-gradient(135deg, #1a3a52 0%, #c85a17 100%); display: flex; align-items: center; justify-content: center;">
          <div style="color: white; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">⚡</div>
            <p style="font-weight: 600;">TRANSMISSION</p>
          </div>
        </div>

        <div class="gallery-item" style="background: linear-gradient(135deg, #c85a17 0%, #1a3a52 100%); display: flex; align-items: center; justify-content: center;">
          <div style="color: white; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">🔌</div>
            <p style="font-weight: 600;">DISTRIBUTION</p>
          </div>
        </div>

        <div class="gallery-item" style="background: linear-gradient(135deg, #1a3a52 0%, #c85a17 100%); display: flex; align-items: center; justify-content: center;">
          <div style="color: white; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">🏭</div>
            <p style="font-weight: 600;">INDUSTRIAL</p>
          </div>
        </div>

        <div class="gallery-item" style="background: linear-gradient(135deg, #c85a17 0%, #1a3a52 100%); display: flex; align-items: center; justify-content: center;">
          <div style="color: white; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">🔧</div>
            <p style="font-weight: 600;">MAINTENANCE</p>
          </div>
        </div>

        <div class="gallery-item" style="background: linear-gradient(135deg, #1a3a52 0%, #c85a17 100%); display: flex; align-items: center; justify-content: center;">
          <div style="color: white; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">⚙️</div>
            <p style="font-weight: 600;">TESTING</p>
          </div>
        </div>

        <div class="gallery-item" style="background: linear-gradient(135deg, #c85a17 0%, #1a3a52 100%); display: flex; align-items: center; justify-content: center;">
          <div style="color: white; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">🛡️</div>
            <p style="font-weight: 600;">SAFETY</p>
          </div>
        </div>

        <div class="gallery-item" style="background: linear-gradient(135deg, #1a3a52 0%, #c85a17 100%); display: flex; align-items: center; justify-content: center;">
          <div style="color: white; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">✓</div>
            <p style="font-weight: 600;">COMPLIANCE</p>
          </div>
        </div>
      </div>
    </section>

    <section style="margin-top: 4rem;">
      <h2 class="section-title">PROJECT HIGHLIGHTS</h2>
      
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem;">
        <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
          <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700;">🏆 AWARDS & RECOGNITION</h3>
          <p style="color: var(--text-light); margin-bottom: 0.75rem;">✓ Industry Excellence</p>
          <p style="color: var(--text-light); margin-bottom: 0.75rem;">✓ Safety Leadership</p>
          <p style="color: var(--text-light);">✓ Client Satisfaction</p>
        </div>
        
        <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
          <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700;">📊 PROJECT STATISTICS</h3>
          <p style="color: var(--text-light); margin-bottom: 0.75rem;">✓ 100+ Successful Projects</p>
          <p style="color: var(--text-light); margin-bottom: 0.75rem;">✓ Zero Safety Incidents</p>
          <p style="color: var(--text-light);">✓ 99.9% On-Time Delivery</p>
        </div>
      </div>
    </section>

    <section style="margin-top: 4rem; margin-bottom: 4rem;">
      <div style="padding: 3rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange); text-align: center;">
        <h2 style="color: var(--primary-dark); margin-bottom: 1.5rem; font-size: 1.5rem; font-weight: 700; text-transform: uppercase;">INTERESTED IN OUR SERVICES?</h2>
        <p style="color: var(--text-dark); margin-bottom: 1.5rem; font-size: 1.05rem;">View our detailed project case studies and discuss your electrical infrastructure requirements with our team.</p>
        <a href="/projects" class="cta-button" style="margin-right: 1rem;">VIEW PROJECTS</a>
        <a href="/contact" class="cta-button" style="background: var(--primary-dark);">GET IN TOUCH</a>
      </div>
    </section>
  </div>
</Layout>
