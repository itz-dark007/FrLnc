---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Clients & Testimonials - Sinewy Electrical Solutions" description="What our clients say about Sinewy Electrical Solutions">
  <section class="hero">
    <div class="container">
      <h1>CLIENTS & TESTIMONIALS</h1>
      <p>TRUSTED BY LEADING COMPANIES AND ORGANIZATIONS</p>
    </div>
  </section>

  <div class="container">
    <section style="margin-bottom: 4rem;">
      <h2 class="section-title">OUR MAJOR CLIENTS</h2>

      <div class="client-logo-grid major-clients-grid" style="margin-top: 2rem;">
        <div class="client-logo-card"><img src="/clients/leela.png" alt="The Leela" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/clients/jockey.png" alt="Jockey" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/clients/lg.png" alt="LG" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/clients/manjushree-2-0.png" alt="Manjushree 2.0" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/clients/emmvee.png" alt="Emmvee" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/clients/cms.png" alt="CMS" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/clients/ag-corporation.png" alt="AG Corporation" class="client-logo-image" /></div>
        <div class="client-logo-card dual-client-logo">
          <img src="/clients/motherson.png" alt="Motherson" class="client-logo-image" />
          <img src="/clients/marelli.png" alt="Marelli" class="client-logo-image" />
        </div>
        <div class="client-logo-card"><img src="/clients/sbc.png" alt="SBC" class="client-logo-image" /></div>
      </div>
    </section>

    <section>
      <h2 class="section-title">WHAT OUR CLIENTS SAY</h2>
      
      <div class="grid">
        <div class="testimonial">
          <p>"Sinewy Electrical Solutions delivered our substation project on time and under budget. Their professionalism and expertise were exceptional."</p>
          <p class="testimonial-author">- Client Representative, Industrial Sector</p>
        </div>

        <div class="testimonial">
          <p>"We've been using their services for multiple projects. The team is reliable, knowledgeable, and responsive to our requirements."</p>
          <p class="testimonial-author">- Project Manager, Manufacturing Company</p>
        </div>

        <div class="testimonial">
          <p>"Emergency electrical issue resolved efficiently. Professional, cost-effective, and highly recommended for critical infrastructure projects."</p>
          <p class="testimonial-author">- Facility Head, Industrial Complex</p>
        </div>

        <div class="testimonial">
          <p>"Their technical expertise in T&D systems was invaluable. Outstanding project execution with zero safety incidents."</p>
          <p class="testimonial-author">- Infrastructure Director, Engineering Firm</p>
        </div>

        <div class="testimonial">
          <p>"Installation was seamless with minimal downtime. Their team's precision and professionalism are truly world-class."</p>
          <p class="testimonial-author">- Operations Manager, Critical Facility</p>
        </div>

        <div class="testimonial">
          <p>"Outstanding technical knowledge and customer service. They understood our complex requirements and delivered beyond expectations."</p>
          <p class="testimonial-author">- Chief Engineer, Infrastructure Development</p>
        </div>
      </div>
    </section>

    <section style="background: var(--light-gray); padding: 3rem; border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
      <h2 class="section-title">CLIENT STATISTICS</h2>
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-top: 2rem;">
        <div style="text-align: center;">
          <h3 style="font-size: 2.5rem; color: var(--secondary-orange); margin-bottom: 0.5rem;">100+</h3>
          <p style="color: var(--primary-dark); font-weight: 600;">Successful Projects</p>
        </div>
        <div style="text-align: center;">
          <h3 style="font-size: 2.5rem; color: var(--secondary-orange); margin-bottom: 0.5rem;">1000+</h3>
          <p style="color: var(--primary-dark); font-weight: 600;">Completed Projects</p>
        </div>
        <div style="text-align: center;">
          <h3 style="font-size: 2.5rem; color: var(--secondary-orange); margin-bottom: 0.5rem;">15+</h3>
          <p style="color: var(--primary-dark); font-weight: 600;">Years Experience</p>
        </div>
        <div style="text-align: center;">
          <h3 style="font-size: 2.5rem; color: var(--secondary-orange); margin-bottom: 0.5rem;">99%</h3>
          <p style="color: var(--primary-dark); font-weight: 600;">Satisfaction Rate</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
