---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Clients & Testimonials" description="What our clients say about Sinewy Electrical Solutions">
  <div class="container">
    <h1 style="color: var(--primary-color); margin-bottom: 2rem; font-size: 2.5rem;">Clients & Testimonials</h1>

    <section style="margin-bottom: 4rem;">
      <h2 style="color: var(--primary-color); margin-bottom: 2rem; font-size: 1.8rem;">What Our Clients Say</h2>
      
      <div class="grid">
        <div class="card" style="border-left: 4px solid var(--secondary-color);">
          <p style="font-style: italic; color: #666; margin-bottom: 1rem;">"Sinewy Electrical Solutions delivered our project on time and under budget. Their professionalism and attention to detail were exceptional."</p>
          <p style="font-weight: 600; color: var(--primary-color);">- John Mitchell, Property Developer</p>
        </div>

        <div class="card" style="border-left: 4px solid var(--secondary-color);">
          <p style="font-style: italic; color: #666; margin-bottom: 1rem;">"We've been using their services for 5 years. The team is reliable, knowledgeable, and always responsive to our needs."</p>
          <p style="font-weight: 600; color: var(--primary-color);">- Sarah Johnson, Manufacturing Manager</p>
        </div>

        <div class="card" style="border-left: 4px solid var(--secondary-color);">
          <p style="font-style: italic; color: #666; margin-bottom: 1rem;">"Emergency electrical issue resolved within hours. Professional and cost-effective. Highly recommended!"</p>
          <p style="font-weight: 600; color: var(--primary-color);">- Michael Chen, Business Owner</p>
        </div>

        <div class="card" style="border-left: 4px solid var(--secondary-color);">
          <p style="font-style: italic; color: #666; margin-bottom: 1rem;">"Their energy efficiency audit saved us thousands annually. Great service and excellent ROI."</p>
          <p style="font-weight: 600; color: var(--primary-color);">- Emma Rodriguez, Facility Director</p>
        </div>

        <div class="card" style="border-left: 4px solid var(--secondary-color);">
          <p style="font-style: italic; color: #666; margin-bottom: 1rem;">"Installation was seamless and they ensured zero downtime. Their team is truly professional."</p>
          <p style="font-weight: 600; color: var(--primary-color);">- David Thompson, Hospital Administrator</p>
        </div>

        <div class="card" style="border-left: 4px solid var(--secondary-color);">
          <p style="font-style: italic; color: #666; margin-bottom: 1rem;">"Outstanding customer service and top-quality work. They understood our requirements perfectly."</p>
          <p style="font-weight: 600; color: var(--primary-color);">- Lisa Wong, Retail Manager</p>
        </div>
      </div>
    </section>

    <section style="background-color: var(--light-bg); padding: 2rem; border-radius: 8px; margin-bottom: 4rem;">
      <h2 style="color: var(--primary-color); margin-bottom: 2rem; text-align: center;">Client Statistics</h2>
      <div class="grid">
        <div style="text-align: center;">
          <h3 style="font-size: 2.5rem; color: var(--secondary-color); margin-bottom: 0.5rem;">500+</h3>
          <p style="color: var(--primary-color); font-weight: 600;">Satisfied Clients</p>
        </div>
        <div style="text-align: center;">
          <h3 style="font-size: 2.5rem; color: var(--secondary-color); margin-bottom: 0.5rem;">1000+</h3>
          <p style="color: var(--primary-color); font-weight: 600;">Completed Projects</p>
        </div>
        <div style="text-align: center;">
          <h3 style="font-size: 2.5rem; color: var(--secondary-color); margin-bottom: 0.5rem;">15+</h3>
          <p style="color: var(--primary-color); font-weight: 600;">Years Experience</p>
        </div>
        <div style="text-align: center;">
          <h3 style="font-size: 2.5rem; color: var(--secondary-color); margin-bottom: 0.5rem;">99%</h3>
          <p style="color: var(--primary-color); font-weight: 600;">Satisfaction Rate</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
