---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Suppliers - Sinewy Electrical Solutions" description="Meet our trusted suppliers and partners">
  <section class="hero">
    <div class="container">
      <h1>OUR SUPPLIERS & PARTNERS</h1>
      <p>PARTNERSHIPS WITH INDUSTRY-LEADING SUPPLIERS</p>
    </div>
  </section>

  <div class="container">
    <section>
      <h2 class="section-title">TRUSTED SUPPLIER PARTNERS</h2>
      <p class="subtitle">We work with industry-leading suppliers to ensure highest quality materials and components.</p>

      <div class="client-logo-grid major-clients-grid" style="margin-top: 2rem;">
        <div class="client-logo-card"><img src="/suppliers/polycab.png" alt="Polycab" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/suppliers/lnt.png" alt="L&T" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/suppliers/abb.png" alt="ABB" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/suppliers/kirloskar.png" alt="Kirloskar" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/suppliers/dowells.png" alt="Dowells" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/suppliers/vyoma-switchgear.png" alt="Vyoma Switchgear" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/suppliers/schneider-electric.png" alt="Schneider Electric" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/suppliers/3m.png" alt="3M" class="client-logo-image" /></div>
        <div class="client-logo-card"><img src="/suppliers/kei.png" alt="KEI Wires & Cables" class="client-logo-image" /></div>
      </div>
    </section>

    <section style="margin-top: 4rem; margin-bottom: 4rem;">
      <h2 class="section-title">WHY WE CHOOSE OUR PARTNERS</h2>
      
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem;">
        <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
          <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700;">✓ QUALITY ASSURANCE</h3>
          <p style="color: var(--text-light);">We only partner with suppliers maintaining highest quality and reliability standards for all materials.</p>
        </div>
        
        <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
          <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700;">💰 COST EFFICIENCY</h3>
          <p style="color: var(--text-light);">Strategic partnerships ensure competitive pricing without compromising quality or reliability.</p>
        </div>

        <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
          <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700;">🚚 RELIABLE SUPPLY</h3>
          <p style="color: var(--text-light);">Consistent supply chains ensuring on-time delivery and project timeline compliance.</p>
        </div>

        <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
          <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700;">🤝 TECHNICAL SUPPORT</h3>
          <p style="color: var(--text-light);">Direct access to supplier technical teams for specialized support and troubleshooting.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
