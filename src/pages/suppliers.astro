---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Suppliers" description="Meet our trusted suppliers and partners">
  <div class="container">
    <h1 style="color: var(--primary-color); margin-bottom: 2rem; font-size: 2.5rem;">Our Suppliers & Partners</h1>

    <p class="section-subtitle">We work with industry-leading suppliers to ensure the highest quality materials and components for our projects.</p>

    <section style="margin-bottom: 4rem;">
      <h2 style="color: var(--primary-color); margin-bottom: 2rem; font-size: 1.8rem;">Trusted Supplier Partners</h2>
      
      <div class="grid">
        <div class="card">
          <h3>Premium Electrical Components</h3>
          <p><strong>Specialization:</strong> Industrial-grade panels, breakers, and distribution equipment</p>
          <p style="margin-top: 1rem;">Providing us with reliable, certified electrical components that meet all industry standards.</p>
        </div>

        <div class="card">
          <h3>Lighting Solutions Inc.</h3>
          <p><strong>Specialization:</strong> LED and energy-efficient lighting systems</p>
          <p style="margin-top: 1rem;">Our partner for modern, sustainable lighting solutions for all project types.</p>
        </div>

        <div class="card">
          <h3>Automation & Control Systems</h3>
          <p><strong>Specialization:</strong> Smart building and automation technologies</p>
          <p style="margin-top: 1rem;">Cutting-edge automation solutions for residential and commercial applications.</p>
        </div>

        <div class="card">
          <h3>Power Generation Systems</h3>
          <p><strong>Specialization:</strong> Generators and backup power solutions</p>
          <p style="margin-top: 1rem;">Reliable backup power systems for critical operations and emergency situations.</p>
        </div>

        <div class="card">
          <h3>Safety & Protection Equipment</h3>
          <p><strong>Specialization:</strong> Surge protection, grounding systems, and safety devices</p>
          <p style="margin-top: 1rem;">Ensuring safety and protection for all electrical systems and components.</p>
        </div>

        <div class="card">
          <h3>Testing & Diagnostic Tools</h3>
          <p><strong>Specialization:</strong> Calibrated testing equipment and diagnostic devices</p>
          <p style="margin-top: 1rem;">State-of-the-art equipment for quality assurance and system testing.</p>
        </div>
      </div>
    </section>

    <section style="background-color: var(--light-bg); padding: 2rem; border-radius: 8px;">
      <h2 style="color: var(--primary-color); margin-bottom: 2rem; text-align: center;">Why Partner With Us?</h2>
      <div class="grid">
        <div class="card">
          <h3>Quality Assurance</h3>
          <p>We only partner with suppliers who maintain the highest quality and reliability standards.</p>
        </div>
        <div class="card">
          <h3>Cost Efficiency</h3>
          <p>Our supplier relationships allow us to offer competitive pricing without compromising quality.</p>
        </div>
        <div class="card">
          <h3>Consistent Supply</h3>
          <p>Strategic partnerships ensure reliable supply chains and on-time delivery for projects.</p>
        </div>
        <div class="card">
          <h3>Technical Support</h3>
          <p>Direct access to supplier technical teams for specialized support and troubleshooting.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
