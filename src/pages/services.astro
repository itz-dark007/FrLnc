---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services" description="Comprehensive electrical services for residential, commercial, and industrial sectors">
  <div class="container">
    <h1 style="color: var(--primary-color); margin-bottom: 2rem; font-size: 2.5rem;">Our Services</h1>

    <section style="margin-bottom: 4rem;">
      <h2 style="color: var(--primary-color); margin-bottom: 2rem; font-size: 1.8rem;">Service Categories</h2>
      
      <div class="grid">
        <div class="card">
          <h3>Residential Electrical Services</h3>
          <p><strong>New Installations:</strong> Complete wiring systems for new homes and renovations.</p>
          <p style="margin-top: 1rem;"><strong>Maintenance & Repairs:</strong> Troubleshooting, repairs, and preventative maintenance.</p>
          <p style="margin-top: 1rem;"><strong>Upgrades:</strong> Panel upgrades, breaker replacements, and capacity improvements.</p>
        </div>

        <div class="card">
          <h3>Commercial Electrical Services</h3>
          <p><strong>Project Installation:</strong> Complete electrical systems for offices, retail spaces, and commercial buildings.</p>
          <p style="margin-top: 1rem;"><strong>Maintenance Programs:</strong> Scheduled maintenance to minimize downtime.</p>
          <p style="margin-top: 1rem;"><strong>Emergency Response:</strong> 24/7 support for critical electrical issues.</p>
        </div>

        <div class="card">
          <h3>Industrial Solutions</h3>
          <p><strong>Heavy-Duty Installation:</strong> Specialized systems for industrial facilities and machinery.</p>
          <p style="margin-top: 1rem;"><strong>Preventative Maintenance:</strong> Planned maintenance to ensure continuous operation.</p>
          <p style="margin-top: 1rem;"><strong>System Optimization:</strong> Improving efficiency and reducing energy costs.</p>
        </div>
      </div>
    </section>

    <section>
      <h2 style="color: var(--primary-color); margin-bottom: 2rem; font-size: 1.8rem;">Additional Services</h2>
      
      <div class="grid">
        <div class="card">
          <h3>Energy Efficiency Audits</h3>
          <p>We analyze your electrical systems to identify energy-saving opportunities and recommend improvements.</p>
        </div>

        <div class="card">
          <h3>Safety Code Compliance</h3>
          <p>Ensure your electrical systems meet all local building codes and safety standards.</p>
        </div>

        <div class="card">
          <h3>Smart Home Solutions</h3>
          <p>Install modern smart home electrical systems with automation and remote control capabilities.</p>
        </div>

        <div class="card">
          <h3>Emergency Services</h3>
          <p>Available 24/7 for urgent electrical problems, power outages, and emergency repairs.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
