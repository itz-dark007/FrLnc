---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home - Sinewy Electrical Solutions" description="Professional electrical solutions and services">
  <section class="hero">
    <div class="container">
      <h1>Sinewy Electrical Solutions</h1>
      <p>Expert Electrical Services for Residential, Commercial & Industrial Projects</p>
      <a href="/contact" class="cta-button">Get in Touch</a>
    </div>
  </section>

  <div class="container">
    <section>
      <h2 class="section-title">Our Services</h2>
      <div class="grid">
        <div class="card">
          <h3>Installation</h3>
          <p>Professional electrical installation services for new construction, renovations, and system upgrades with full compliance to all safety standards.</p>
        </div>
        <div class="card">
          <h3>Maintenance</h3>
          <p>Scheduled maintenance programs to keep your electrical systems running efficiently and prevent costly downtime or failures.</p>
        </div>
        <div class="card">
          <h3>Consultation</h3>
          <p>Expert consultation for electrical system design, upgrades, and compliance with local codes and regulations.</p>
        </div>
      </div>
    </section>

    <section style="margin-top: 4rem;">
      <h2 class="section-title">Why Choose Us</h2>
      <div class="grid">
        <div class="card">
          <h3>✓ Licensed & Insured</h3>
          <p>All our electricians are fully licensed and our company carries comprehensive insurance coverage.</p>
        </div>
        <div class="card">
          <h3>✓ 24/7 Support</h3>
          <p>Emergency services available around the clock for urgent electrical issues.</p>
        </div>
        <div class="card">
          <h3>✓ Quality Guarantee</h3>
          <p>We stand behind our work with warranties on all services and installations.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
