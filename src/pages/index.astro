---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home - Sinewy Electrical Solutions" description="Professional electrical solutions and services for industrial & infrastructure projects">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <h1>SINEWY ELECTRICAL SOLUTIONS</h1>
      <p>CLASS-1 ELECTRICAL CONTRACTOR</p>
      <p style="font-size: 1.1rem; opacity: 0.95;">RELIABLE POWER SOLUTIONS FOR INDUSTRIAL & INFRASTRUCTURE PROJECTS</p>
      <a href="/contact" class="cta-button">EXPLORE SERVICES</a>
    </div>
  </section>

  <div class="container">
    <!-- About Our Profile Section -->
    <section>
      <div class="about-profile">
        <h2>ABOUT OUR PROFILE</h2>
        <div style="display: flex; gap: 2rem; align-items: flex-start; margin-bottom: 1.5rem;">
          <div style="font-size: 2.5rem;">⚡</div>
          <div>
            <p><strong>SINEWY ELECTRICAL SOLUTIONS</strong> is a trusted Class-1 contractor in Bangalore (and beyond) with decades of experience in complex electrical infrastructure. We are committed to engineering excellence, safety, and innovation with advanced tools and highly skilled personnel.</p>
          </div>
        </div>
        <div style="display: flex; gap: 2rem; align-items: flex-start;">
          <div style="font-size: 2.5rem;">🌍</div>
          <div>
            <p>We are committed to engineering excellence, safety, and innovation in every project we undertake. Our team works with advanced tools and proven methodologies to deliver reliable power solutions that meet all regulatory standards and client expectations.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Projects Section -->
    <section style="margin-top: 4rem;">
      <h2 class="section-title">FEATURED PROJECTS: DETAILED CASE STUDIES</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3>📊 Substations</h3>
          <p><strong>BANGALORE SUBSTATION UPGRADE</strong> - Successfully completed comprehensive upgrade of critical substation infrastructure with zero downtime.</p>
        </div>
        <div class="card">
          <h3>🏭 T&D</h3>
          <p><strong>TRANSMISSION & DISTRIBUTION</strong> - Large-scale transmission line installation connecting industrial zones with optimal efficiency.</p>
        </div>
        <div class="card">
          <h3>⚙️ Industrial</h3>
          <p><strong>INDUSTRIAL ELECTRIFICATION</strong> - Complex industrial facility electrification with state-of-the-art power systems.</p>
        </div>
      </div>
      <div class="grid grid-3" style="margin-top: 2rem;">
        <div class="card">
          <h3>📍 BANGALORE SUBSTATION UPGRADE</h3>
          <p><strong>Location:</strong> Bangalore | <strong>Type:</strong> Substation Infrastructure</p>
        </div>
        <div class="card">
          <h3>📍 MAINTENANCE & UPGRADE</h3>
          <p><strong>Location:</strong> Bangalore | <strong>Type:</strong> Substation Maintenance</p>
        </div>
        <div class="card">
          <h3>📍 BANGALORE SUBSTATION UPGRADE</h3>
          <p><strong>Location:</strong> Bangalore | <strong>Type:</strong> Substation Infrastructure</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href="/projects" class="view-button">Show More »</a>
      </div>
    </section>

    <!-- Mission & Vision Section -->
    <section style="margin-top: 4rem;">
      <div class="mission-vision">
        <div class="mission-box">
          <div style="font-size: 2rem; margin-bottom: 1rem;">🎯</div>
          <h3>MISSION</h3>
          <ul>
            <li>To continuously learn and implement the new technology for the betterment of organisation.</li>
            <li>To provide the best possible electrical services with better quality and safety to achieve customer satisfaction.</li>
            <li>To maintain good working environment and team work.</li>
            <li>To achieve flexibility and adaptability to work in a team.</li>
          </ul>
        </div>
        <div class="vision-box">
          <div style="font-size: 2rem; margin-bottom: 1rem;">🔭</div>
          <h3>VISION</h3>
          <p>To be the best industry experts in providing Electrical Assistance and Services.</p>
        </div>
      </div>
    </section>

    <!-- Our Comprehensive Electrical Services Section -->
    <section style="margin-top: 4rem; margin-bottom: 4rem;">
      <h2 class="section-title">OUR COMPREHENSIVE ELECTRICAL SERVICES: DETAILED PORTFOLIO</h2>
      
      <div class="features-grid">
        <div class="service-card">
          <div class="service-icon">🏢</div>
          <h3>SUBSTATION INSTALLATION</h3>
          <ul class="service-list">
            <li>Detailed planning</li>
            <li>Safety Standards</li>
            <li>Erection</li>
            <li>Switchgear</li>
          </ul>
          <a href="/contact" class="view-button">REQUEST QUOTE</a>
        </div>

        <div class="service-card">
          <div class="service-icon">⚡</div>
          <h3>TRANSMISSION & DISTRIBUTION</h3>
          <ul class="service-list">
            <li>Line stringing</li>
            <li>Pole erection</li>
            <li>Insulators</li>
            <li>Cable laying</li>
          </ul>
          <a href="/contact" class="view-button">REQUEST QUOTE</a>
        </div>

        <div class="service-card">
          <div class="service-icon">🔧</div>
          <h3>INDUSTRIAL ELECTRIFICATION</h3>
          <ul class="service-list">
            <li>Heavy equipment wiring</li>
            <li>Control panels</li>
            <li>Facility solutions</li>
            <li>Automation systems</li>
          </ul>
          <a href="/contact" class="view-button">REQUEST QUOTE</a>
        </div>
      </div>
    </section>
  </div>

  <!-- Sidebar Sections (Right side content) -->
  <div class="container">
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 3rem; margin: 3rem 0;">
      <!-- Main content area (left) -->
      <div>
        <!-- Gallery Section Preview -->
        <section>
          <h2 class="section-title">GALLERY</h2>
          <div class="gallery-grid">
            <div class="gallery-item"><img src="/gallery/g1.jpeg" alt="Gallery image 1" /></div>
            <div class="gallery-item"><img src="/gallery/g2.jpeg" alt="Gallery image 2" /></div>
            <div class="gallery-item"><img src="/gallery/g3.jpeg" alt="Gallery image 3" /></div>
            <div class="gallery-item"><img src="/gallery/g4.jpeg" alt="Gallery image 4" /></div>
          </div>
        </section>

        <!-- Team Section Preview -->
        <section style="margin-top: 4rem;">
          <h2 class="section-title">TEAM</h2>
          <div class="grid grid-4">
            <div class="team-member">
              <h3>Mr. Revana Siddappa</h3>
              <p class="team-role">Project Head</p>
              <p class="team-experience">18 years Experience in all Installation and maintenance of Electrical Equipment's.</p>
            </div>
            <div class="team-member">
              <h3>Miss. Anupama N M</h3>
              <p class="team-role">Design & Project Co-ordinator</p>
            </div>
            <div class="team-member">
              <h3>Mr. Srinivas</h3>
              <p class="team-role">Technical Head</p>
              <p class="team-experience">12 years Experience in Power Transformer & Distribution Transformer Service & Installation.</p>
            </div>
            <div class="team-member">
              <h3>Mr. Raghu T S</h3>
              <p class="team-role">Head of Purchase & Sales Department</p>
            </div>
          </div>
          <div style="text-align: center; margin-top: 1.5rem;">
            <a href="/team" class="cta-button">VIEW FULL TEAM</a>
          </div>
        </section>

        <!-- Contact Section -->
        <section style="margin-top: 4rem; margin-bottom: 4rem;">
          <h2 class="section-title">CONTACT</h2>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
            <form class="contact-form" style="margin: 0; background: transparent; padding: 0;">
              <div class="form-group">
                <label>Name</label>
                <input type="text" placeholder="Your Name" required />
              </div>
              <div class="form-group">
                <label>Email</label>
                <input type="email" placeholder="Your Email" required />
              </div>
              <div class="form-group">
                <label>Message</label>
                <textarea placeholder="Your Message" required></textarea>
              </div>
              <button type="submit" class="form-submit">SUBMIT REQUEST</button>
            </form>
            
            <div style="background: var(--light-gray); padding: 2rem; border-radius: 8px;">
              <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 600;">CONTACT INFORMATION</h3>
              <p style="margin-bottom: 0.75rem;"><strong>Address:</strong><br>#98, 10th A Main, Hongasandra, Begur Road, Bangalore - 560 068</p>
              <p style="margin-bottom: 0.75rem;"><strong>Phone:</strong><br>87926 29665 / 99007 34608</p>
              <p style="margin-bottom: 0.75rem;"><strong>Email:</strong><br>sinewyeletricalsolutions@gmail.com</p>
              <p style="margin-bottom: 0.75rem;"><strong>Hours:</strong><br>Mon - Fri: 9:00 AM - 6:00 PM<br>Sat: 9:00 AM - 1:00 PM<br>Sun: Closed</p>
            </div>
          </div>
        </section>
      </div>

      <!-- Right Sidebar -->
      <aside>
        <!-- Clients & Testimonials -->
        <section style="margin-bottom: 3rem;">
          <h3 style="color: var(--primary-dark); font-size: 1.25rem; margin-bottom: 1.5rem; font-weight: 700; text-transform: uppercase;">CLIENTS & TESTIMONIALS</h3>
          <div style="background: var(--light-gray); padding: 1.5rem; border-radius: 8px; text-align: center;">
            <p style="color: var(--text-light); font-size: 0.9rem; margin-bottom: 1rem;">Trusted by leading companies</p>
            <div class="client-logo-grid sidebar-client-logos" style="margin-top: 0;">
              <div class="client-logo-card"><img src="/clients/leela.png" alt="The Leela" class="client-logo-image" /></div>
              <div class="client-logo-card"><img src="/clients/jockey.png" alt="Jockey" class="client-logo-image" /></div>
              <div class="client-logo-card"><img src="/clients/lg.png" alt="LG" class="client-logo-image" /></div>
              <div class="client-logo-card"><img src="/clients/cms.png" alt="CMS" class="client-logo-image" /></div>
            </div>
            <div style="margin-top: 1rem;">
              <a href="/clients" class="view-button" style="display: inline-block; width: auto; padding: 0.6rem 1rem;">VIEW ALL CLIENTS</a>
            </div>
          </div>
        </section>

        <!-- Suppliers -->
        <section style="margin-bottom: 3rem;">
          <h3 style="color: var(--primary-dark); font-size: 1.25rem; margin-bottom: 1.5rem; font-weight: 700; text-transform: uppercase;">SUPPLIERS</h3>
          <div style="background: var(--light-gray); padding: 1.5rem; border-radius: 8px; text-align: center;">
            <div style="display: grid; grid-template-columns: 1fr; gap: 0.75rem;">
              <div class="client-logo-card" style="min-height: 84px; background: var(--white);">
                <img src="/suppliers/polycab.png" alt="Polycab" class="client-logo-image" style="max-height: 42px;" />
              </div>
              <div class="client-logo-card" style="min-height: 84px; background: var(--white);">
                <img src="/suppliers/lnt.png" alt="L&T" class="client-logo-image" style="max-height: 42px;" />
              </div>
              <div class="client-logo-card" style="min-height: 84px; background: var(--white);">
                <img src="/suppliers/abb.png" alt="ABB" class="client-logo-image" style="max-height: 42px;" />
              </div>
            </div>
            <div style="margin-top: 1rem;">
              <a href="/suppliers" class="view-button" style="display: inline-block; width: auto; padding: 0.6rem 1rem;">VIEW ALL SUPPLIERS</a>
            </div>
          </div>
        </section>

      </aside>
    </div>
  </div>
</Layout>
