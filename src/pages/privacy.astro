---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy - Sinewy Electrical Solutions" description="Privacy policy for Sinewy Electrical Solutions">
  <section class="hero">
    <div class="container">
      <h1>PRIVACY POLICY</h1>
      <p>YOUR DATA PROTECTION & PRIVACY RIGHTS</p>
    </div>
  </section>

  <div class="container" style="max-width: 900px; margin-top: 3rem; margin-bottom: 4rem;">
    <p style="color: var(--text-light); margin-bottom: 2rem;"><strong>Last updated: March 2026</strong></p>

    <section style="margin-bottom: 3rem;">
      <h2 style="color: var(--primary-dark); margin-bottom: 1.5rem; font-size: 1.3rem; font-weight: 700;">1. INTRODUCTION</h2>
      <p style="color: var(--text-dark); line-height: 1.8;">
        Sinewy Electrical Solutions ("we," "us," "our") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website and use our services.
      </p>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="color: var(--primary-dark); margin-bottom: 1.5rem; font-size: 1.3rem; font-weight: 700;">2. INFORMATION WE COLLECT</h2>
      <p style="color: var(--text-dark); line-height: 1.8; margin-bottom: 1rem;">We may collect the following information:</p>
      <ul style="margin-left: 2rem; color: var(--text-dark); line-height: 1.8;">
        <li>Personal identification (name, email, phone, address)</li>
        <li>Service-related information (project scope, location, specifications)</li>
        <li>Payment information (processed securely through providers)</li>
        <li>Website usage data (cookies, IP address)</li>
      </ul>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="color: var(--primary-dark); margin-bottom: 1.5rem; font-size: 1.3rem; font-weight: 700;">3. HOW WE USE YOUR INFORMATION</h2>
      <p style="color: var(--text-dark); line-height: 1.8;">We use your information to provide services, improve our website, communicate about your projects, and protect our legal interests. Your information is never sold to third parties.</p>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="color: var(--primary-dark); margin-bottom: 1.5rem; font-size: 1.3rem; font-weight: 700;">4. DATA SECURITY</h2>
      <p style="color: var(--text-dark); line-height: 1.8;">We implement appropriate security measures to protect your personal information from unauthorized access, alteration, disclosure, and destruction.</p>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="color: var(--primary-dark); margin-bottom: 1.5rem; font-size: 1.3rem; font-weight: 700;">5. YOUR RIGHTS</h2>
      <p style="color: var(--text-dark); line-height: 1.8;">You have the right to access, update, or delete your personal information. Contact us for any privacy requests or concerns.</p>
    </section>

    <div class="divider"></div>

    <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange); margin-top: 2rem;">
      <p style="color: var(--primary-dark); margin-bottom: 1rem;"><strong>Questions about our privacy practices?</strong></p>
      <p style="color: var(--text-light);">Contact us at <a href="mailto:sinewyeletricalsolutions@gmail.com" style="color: var(--secondary-orange); text-decoration: none;">sinewyeletricalsolutions@gmail.com</a> or call <a href="tel:+918792629665" style="color: var(--secondary-orange); text-decoration: none;">87926 29665</a></p>
    </div>
  </div>
</Layout>
