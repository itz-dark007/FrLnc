---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Legal Compliance - Sinewy Electrical Solutions" description="Legal compliance information for Sinewy Electrical Solutions">
  <section class="hero">
    <div class="container">
      <h1>LEGAL COMPLIANCE</h1>
      <p>CERTIFICATIONS, LICENSING & REGULATORY STANDARDS</p>
    </div>
  </section>

  <div class="container">
    <section>
      <h2 class="section-title">LEGAL COMPLIANCE</h2>

      <div class="services-reference-block" style="max-width: 100%;">
        <div class="legal-compliance-list">
          <p class="legal-compliance-title">Class-1 Electrical Contractor License No – 1CL143983BNG</p>
          <div class="legal-compliance-row"><span>SHOP REG. No</span><strong>38/189/S/0053/2021</strong></div>
          <div class="legal-compliance-row"><span>MSME</span><strong>UDYAM-KR-03-0084866</strong></div>
          <div class="legal-compliance-row"><span>Supervisor License No</span><strong>1GR144404BNG</strong></div>
          <div class="legal-compliance-row"><span>GST Registration No</span><strong>29DYVPM9357L1Z1</strong></div>
          <div class="legal-compliance-row"><span>PAN Registration No</span><strong>29DYVPM9357L</strong></div>
          <div class="legal-compliance-row"><span>TAN Registration No</span><strong>BLRA44231F</strong></div>
        </div>
      </div>
    </section>

    <section style="margin-top: 4rem;">
      <h2 class="section-title">CODE COMPLIANCE & STANDARDS</h2>
      
      <div style="background: var(--light-gray); padding: 3rem; border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
        <p style="color: var(--text-dark); line-height: 1.8; margin-bottom: 1.5rem;">Sinewy Electrical Solutions ensures all work complies with the National Electrical Code (NEC), local building codes, and all applicable electrical standards. We maintain strict adherence to:</p>
        
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
          <div>
            <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700;">NATIONAL STANDARDS</h3>
            <ul style="list-style: none; color: var(--text-light);">
              <li style="padding: 0.5rem 0;"><strong>✓</strong> National Electrical Code (NEC)</li>
              <li style="padding: 0.5rem 0;"><strong>✓</strong> American National Standards</li>
              <li style="padding: 0.5rem 0;"><strong>✓</strong> ANSI/NFPA Standards</li>
              <li style="padding: 0.5rem 0;"><strong>✓</strong> IEEE Standards</li>
            </ul>
          </div>
          
          <div>
            <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700;">LOCAL & REGULATORY</h3>
            <ul style="list-style: none; color: var(--text-light);">
              <li style="padding: 0.5rem 0;"><strong>✓</strong> Local Building Codes</li>
              <li style="padding: 0.5rem 0;"><strong>✓</strong> State Safety Regulations</li>
              <li style="padding: 0.5rem 0;"><strong>✓</strong> Federal Requirements</li>
              <li style="padding: 0.5rem 0;"><strong>✓</strong> Environmental Rules</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section style="margin-top: 4rem;">
      <h2 class="section-title">INSPECTIONS & TESTING</h2>
      
      <div class="grid grid-4">
        <div class="service-card">
          <div class="service-icon">🔍</div>
          <h3>INSPECTIONS</h3>
          <p>Municipal inspections and testing for code compliance verification.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">⚡</div>
          <h3>SYSTEM TESTING</h3>
          <p>Comprehensive testing of all electrical systems upon completion.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">📋</div>
          <h3>DOCUMENTATION</h3>
          <p>Detailed maintenance records with compliance verification and reporting.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">🏆</div>
          <h3>SAFETY AUDITS</h3>
          <p>Regular third-party audits ensuring ongoing compliance and best practices.</p>
        </div>
      </div>
    </section>

    <section style="margin-top: 4rem; margin-bottom: 4rem;">
      <div style="padding: 3rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
        <h2 class="section-title" style="margin-bottom: 1.5rem;">COMPLIANCE ASSURANCE</h2>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;">
          <div style="text-align: center;">
            <div style="font-size: 2.5rem; color: var(--secondary-orange); margin-bottom: 1rem;">ISO</div>
            <p style="color: var(--primary-dark); font-weight: 600;">CERTIFIED</p>
          </div>
          <div style="text-align: center;">
            <div style="font-size: 2.5rem; color: var(--secondary-orange); margin-bottom: 1rem;">✓</div>
            <p style="color: var(--primary-dark); font-weight: 600;">AUDITED</p>
          </div>
          <div style="text-align: center;">
            <div style="font-size: 2.5rem; color: var(--secondary-orange); margin-bottom: 1rem;">🛡️</div>
            <p style="color: var(--primary-dark); font-weight: 600;">VERIFIED</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
