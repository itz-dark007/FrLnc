---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Team - Sinewy Electrical Solutions" description="Meet the expert team behind Sinewy Electrical Solutions">
  <section class="hero">
    <div class="container">
      <h1>OUR TEAM</h1>
      <p>SKILLED PROFESSIONALS COMMITTED TO EXCELLENCE</p>
    </div>
  </section>

  <div class="container">
    <section>
      <h2 class="section-title">MEET OUR EXPERT TEAM</h2>
      <p class="subtitle">Experienced professionals bringing expertise, dedication, and excellence to every electrical project.</p>

      <div class="grid grid-4">
        <div class="team-member">
          <h3>Mr. Revana Siddappa</h3>
          <p class="team-role">Project Head</p>
          <p class="team-experience">18 years Experience in all Installation and maintenance of Electrical Equipment's.</p>
        </div>

        <div class="team-member">
          <h3>Miss. Anupama N M</h3>
          <p class="team-role">Design & Project Co-ordinator</p>
        </div>

        <div class="team-member">
          <h3>Mr. Srinivas</h3>
          <p class="team-role">Technical Head</p>
          <p class="team-experience">12 years Experience in Power Transformer & Distribution Transformer Service & Installation.</p>
        </div>

        <div class="team-member">
          <h3>Mr. Raghu T S</h3>
          <p class="team-role">Head of Purchase & Sales Department</p>
        </div>

        <div class="team-member">
          <h3>Mr. Harisha M N</h3>
          <p class="team-role">Technical Head</p>
          <p class="team-experience">6 years of Experience in all Installation & Maintenance of Electrical Equipments.</p>
        </div>

        <div class="team-member">
          <h3>Mr. Parashuram Thatti</h3>
          <p class="team-role">Project Manager</p>
          <p class="team-experience">5 years of Experience in all Installation & Maintenance of Electrical Equipments.</p>
        </div>

        <div class="team-member">
          <h3>Mr. Kumar</h3>
          <p class="team-role">Accounts Manager & Liaisoning Expert</p>
        </div>

        <div class="team-member">
          <h3>Electrical Technician Team</h3>
          <p class="team-role">Well skilled Electrical Technician team</p>
        </div>
      </div>
    </section>

    <section style="margin-top: 4rem;">
      <h2 class="section-title">OUR TEAM EXPERTISE</h2>
      
      <div class="grid grid-3">
        <div class="service-card">
          <div class="service-icon">📚</div>
          <h3>CERTIFIED & TRAINED</h3>
          <p>All team members hold relevant certifications and undergo continuous professional development programs.</p>
          <ul class="service-list">
            <li>Class-1 Licensing</li>
            <li>Safety Certifications</li>
            <li>Technical Training</li>
            <li>Advanced Qualifications</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-icon">⏱️</div>
          <h3>EXPERIENCED PROFESSIONALS</h3>
          <p>Decades of combined experience across all electrical infrastructure sectors and project scales.</p>
          <ul class="service-list">
            <li>10+ Years Average</li>
            <li>Specialized Expertise</li>
            <li>Industry Leaders</li>
            <li>Proven Track Records</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-icon">🎯</div>
          <h3>DEDICATED COMMITMENT</h3>
          <p>Team members share core values of excellence, safety, integrity, and customer satisfaction.</p>
          <ul class="service-list">
            <li>Safety Priority</li>
            <li>Quality Focused</li>
            <li>Customer First</li>
            <li>Innovation Driven</li>
          </ul>
        </div>
      </div>
    </section>

    <section style="margin-top: 4rem; margin-bottom: 4rem;">
      <h2 class="section-title">TEAM VALUES & CULTURE</h2>
      
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem;">
        <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
          <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700;">✓ EXCELLENCE</h3>
          <p style="color: var(--text-light);">Continuous pursuit of the highest standards in technical proficiency, craftsmanship, and customer service delivery.</p>
        </div>
        
        <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
          <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700;">🛡️ SAFETY</h3>
          <p style="color: var(--text-light);">Unwavering commitment to safety protocols, regulatory compliance, and protecting our team and clients.</p>
        </div>

        <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
          <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700;">🤝 INTEGRITY</h3>
          <p style="color: var(--text-light);">Honest communication, transparent practices, and professional ethics in all client and team interactions.</p>
        </div>

        <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
          <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700;">🌟 INNOVATION</h3>
          <p style="color: var(--text-light);">Embracing modern technologies and advancing techniques to deliver cutting-edge electrical solutions.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
