---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Team" description="Meet the expert team behind Sinewy Electrical Solutions">
  <div class="container">
    <h1 style="color: var(--primary-color); margin-bottom: 2rem; font-size: 2.5rem;">Our Team</h1>

    <p class="section-subtitle">Meet the skilled professionals who bring expertise, dedication, and excellence to every project.</p>

    <div class="grid">
      <div class="card">
        <h3>James Robertson</h3>
        <p style="color: var(--secondary-color); font-weight: 600; margin-bottom: 1rem;">Chief Executive Officer & Founder</p>
        <p>With over 20 years of industry experience, James leads our company's vision and strategic direction. Licensed master electrician with expertise in industrial systems.</p>
      </div>

      <div class="card">
        <h3>Patricia Williams</h3>
        <p style="color: var(--secondary-color); font-weight: 600; margin-bottom: 1rem;">Operations Manager</p>
        <p>Patricia oversees project coordination and implementation, ensuring timely delivery and quality standards across all operations.</p>
      </div>

      <div class="card">
        <h3>Michael Anderson</h3>
        <p style="color: var(--secondary-color); font-weight: 600; margin-bottom: 1rem;">Lead Electrical Engineer</p>
        <p>Michael specializes in complex system design and industrial installations. PE certified with 15+ years of experience in commercial and industrial projects.</p>
      </div>

      <div class="card">
        <h3>Sarah Martinez</h3>
        <p style="color: var(--secondary-color); font-weight: 600; margin-bottom: 1rem;">Senior Electrician - Residential</p>
        <p>Specialist in residential installations and renovations with a focus on customer satisfaction and safety compliance.</p>
      </div>

      <div class="card">
        <h3>David Kim</h3>
        <p style="color: var(--secondary-color); font-weight: 600; margin-bottom: 1rem;">Technical Systems Specialist</p>
        <p>Expertise in smart home systems, automation, and renewable energy solutions. Holds multiple certifications in modern electrical technologies.</p>
      </div>

      <div class="card">
        <h3>Emma Thompson</h3>
        <p style="color: var(--secondary-color); font-weight: 600; margin-bottom: 1rem;">Safety & Compliance Officer</p>
        <p>Ensures all projects meet or exceed safety standards and regulatory requirements. Coordinates training and compliance auditing.</p>
      </div>

      <div class="card">
        <h3>Carlos Rodriguez</h3>
        <p style="color: var(--secondary-color); font-weight: 600; margin-bottom: 1rem;">Field Supervisor</p>
        <p>Oversees on-site installations and maintenance, with 12 years of hands-on electrical experience and strong team management skills.</p>
      </div>

      <div class="card">
        <h3>Lisa Chen</h3>
        <p style="color: var(--secondary-color); font-weight: 600; margin-bottom: 1rem;">Customer Service Manager</p>
        <p>Dedicated to providing exceptional customer support and managing client relationships. Handles emergency calls and service coordination.</p>
      </div>
    </div>

    <section style="background-color: var(--light-bg); padding: 2rem; border-radius: 8px; margin-top: 4rem;">
      <h2 style="color: var(--primary-color); margin-bottom: 2rem; text-align: center;">Our Team Values</h2>
      <div class="grid">
        <div class="card">
          <h3>Expertise</h3>
          <p>Continuous learning and staying updated with industry standards and best practices.</p>
        </div>
        <div class="card">
          <h3>Integrity</h3>
          <p>Honest communication and transparent dealings with all clients and partners.</p>
        </div>
        <div class="card">
          <h3>Safety</h3>
          <p>Prioritizing safety in every project and maintaining rigorous compliance standards.</p>
        </div>
        <div class="card">
          <h3>Excellence</h3>
          <p>Delivering superior quality work and exceeding client expectations consistently.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
