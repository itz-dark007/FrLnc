---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us" description="Learn about Sinewy Electrical Solutions and our company profile">
  <div class="container">
    <h1 style="color: var(--primary-color); margin-bottom: 2rem; font-size: 2.5rem;">About Sinewy Electrical Solutions</h1>
    
    <section style="margin-bottom: 3rem;">
      <h2 style="color: var(--primary-color); margin-bottom: 1rem;">Company Profile</h2>
      <p style="font-size: 1.1rem; line-height: 1.8; color: #666;">
        Sinewy Electrical Solutions is a leading provider of comprehensive electrical services serving residential, commercial, and industrial sectors. With over a decade of experience, we've built our reputation on reliability, expertise, and customer satisfaction.
      </p>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="color: var(--primary-color); margin-bottom: 2rem;">Mission & Vision</h2>
      <div class="grid">
        <div class="card">
          <h3>Our Mission</h3>
          <p>To provide safe, reliable, and innovative electrical solutions that exceed client expectations while maintaining the highest standards of professionalism and integrity.</p>
        </div>
        <div class="card">
          <h3>Our Vision</h3>
          <p>To be the most trusted electrical solutions provider in the region, recognized for our commitment to quality, safety, and customer service excellence.</p>
        </div>
      </div>
    </section>

    <section>
      <h2 style="color: var(--primary-color); margin-bottom: 2rem;">What Sets Us Apart</h2>
      <div class="grid">
        <div class="card">
          <h3>Expert Team</h3>
          <p>Our electricians are highly trained, certified, and continuously updated with the latest industry standards and techniques.</p>
        </div>
        <div class="card">
          <h3>Safety First</h3>
          <p>We prioritize safety in every project, strictly adhering to all relevant codes, standards, and best practices.</p>
        </div>
        <div class="card">
          <h3>Customer Focus</h3>
          <p>Your satisfaction is our priority. We provide transparent communication and personalized service for every project.</p>
        </div>
        <div class="card">
          <h3>Innovation</h3>
          <p>We stay ahead of industry trends and implement modern solutions for energy efficiency and sustainability.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
