---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects - Sinewy Electrical Solutions" description="View our portfolio of completed electrical infrastructure projects">
  <section class="hero">
    <div class="container">
      <h1>OUR PROJECTS</h1>
      <p>FEATURED CASE STUDIES AND INFRASTRUCTURE SOLUTIONS</p>
    </div>
  </section>

  <div class="container">
    <section>
      <h2 class="section-title">FEATURED PROJECTS: DETAILED CASE STUDIES</h2>

      <div class="grid grid-3">
        <div class="card">
          <h3>📍 CMS Interiors 500KVA new HT Service</h3>
          <p>Completed installation of 500KVA new HT service for CMS Interiors.</p>
        </div>

        <div class="card">
          <h3>📍 Leela Hotel Transformer Replacement</h3>
          <p>Replacement of 3 Nos of 2000KVA Transformer for Leela Hotel Power Sanction from BESCOM & Service.</p>
        </div>

        <div class="card">
          <h3>📍 RRR Layout Mysuru Installation</h3>
          <p>RRR Layout Mysuru Electrical Installation work.</p>
        </div>

        <div class="card">
          <h3>📍 Jockey GOS HT External Service</h3>
          <p>Jockey GOS HT External Service.</p>
        </div>

        <div class="card">
          <h3>📍 Vinayaka & Company</h3>
          <p>Vinayaka & Company CR Submission work.</p>
        </div>

        <div class="card">
          <h3>📍 LG Soft India Pvt Ltd</h3>
          <p>CEIG Drawing & Commissioning Approval for LG Soft India Pvt Ltd.</p>
        </div>

        <div class="card">
          <h3>📍 Maralli Motherson Automotive Ltd</h3>
          <p>DG Approval for Maralli Motherson Automotive Ltd.</p>
        </div>

        <div class="card">
          <h3>📍 Pragathi Automation Pvt Ltd</h3>
          <p>250Kwp Solar Synchronisation from BESCOM.</p>
        </div>

        <div class="card">
          <h3>📍 KHB Suryacity</h3>
          <p>Power sanction from BESCOM.</p>
        </div>
      </div>
    </section>

    <section style="margin-top: 4rem; margin-bottom: 4rem;">
      <h2 class="section-title">PROJECT HIGHLIGHTS</h2>
      
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem;">
        <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px;">
          <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700; text-transform: uppercase;">QUALITY & SAFETY</h3>
          <p style="color: var(--text-light); margin-bottom: 0.75rem;">✓ Zero Safety Incidents</p>
          <p style="color: var(--text-light); margin-bottom: 0.75rem;">✓ Full Compliance with Standards</p>
          <p style="color: var(--text-light);">✓ Comprehensive Testing & Commissioning</p>
        </div>
        
        <div style="padding: 2rem; background: var(--light-gray); border-radius: 8px;">
          <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-weight: 700; text-transform: uppercase;">PROJECT DELIVERY</h3>
          <p style="color: var(--text-light); margin-bottom: 0.75rem;">✓ On-Schedule Completion</p>
          <p style="color: var(--text-light); margin-bottom: 0.75rem;">✓ Budget Management</p>
          <p style="color: var(--text-light);">✓ Professional Team Execution</p>
        </div>
      </div>

      <div style="margin-top: 2rem; padding: 3rem; background: var(--light-gray); border-radius: 8px; border-left: 4px solid var(--secondary-orange);">
        <h3 style="color: var(--primary-dark); margin-bottom: 1.5rem; font-weight: 700; text-transform: uppercase;">READY TO START YOUR PROJECT?</h3>
        <p style="color: var(--text-dark); margin-bottom: 1.5rem;">Contact us today to discuss your electrical infrastructure needs and get a comprehensive consultation.</p>
        <a href="/contact" class="cta-button">GET IN TOUCH</a>
      </div>
    </section>
  </div>
</Layout>
