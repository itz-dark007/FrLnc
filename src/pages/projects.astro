---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects" description="View our portfolio of completed electrical projects">
  <div class="container">
    <h1 style="color: var(--primary-color); margin-bottom: 2rem; font-size: 2.5rem;">Our Projects</h1>

    <p class="section-subtitle">Explore our portfolio of successfully completed electrical projects across various sectors and scales.</p>

    <div class="grid">
      <div class="card">
        <h3>Commercial Office Complex</h3>
        <p><strong>Sector:</strong> Commercial</p>
        <p><strong>Project Type:</strong> New Installation</p>
        <p style="margin-top: 1rem;">Complete electrical systems installation for a 50,000 sq ft office complex including distribution networks, emergency systems, and smart building integration.</p>
      </div>

      <div class="card">
        <h3>Residential Community Development</h3>
        <p><strong>Sector:</strong> Residential</p>
        <p><strong>Project Type:</strong> Multi-Unit Installation</p>
        <p style="margin-top: 1rem;">Electrical infrastructure for 100+ residential units with safety systems, emergency backup, and modern energy-efficient solutions.</p>
      </div>

      <div class="card">
        <h3>Manufacturing Facility Upgrade</h3>
        <p><strong>Sector:</strong> Industrial</p>
        <p><strong>Project Type:</strong> System Upgrade</p>
        <p style="margin-top: 1rem;">Major electrical system upgrade for industrial manufacturing plant including heavy-duty panels, machinery connections, and safety systems.</p>
      </div>

      <div class="card">
        <h3>Hospital Infrastructure</h3>
        <p><strong>Sector:</strong> Healthcare</p>
        <p><strong>Project Type:</strong> Critical Systems</p>
        <p style="margin-top: 1rem;">Specialized electrical systems for hospital operations including backup power, emergency lighting, and critical care equipment installations.</p>
      </div>

      <div class="card">
        <h3>Shopping Mall Renovation</h3>
        <p><strong>Sector:</strong> Commercial</p>
        <p><strong>Project Type:</strong> Renovation</p>
        <p style="margin-top: 1rem;">Complete electrical system renovation for shopping mall including load management, lighting upgrades, and energy optimization.</p>
      </div>

      <div class="card">
        <h3>Data Center Installation</h3>
        <p><strong>Sector:</strong> Industrial/Tech</p>
        <p><strong>Project Type:</strong> Specialized Installation</p>
        <p style="margin-top: 1rem;">High-capacity electrical infrastructure for data center with redundant systems, cooling systems support, and backup generators.</p>
      </div>
    </div>

    <section style="margin-top: 4rem; padding: 2rem; background-color: var(--light-bg); border-radius: 8px; text-align: center;">
      <h2 style="color: var(--primary-color); margin-bottom: 1rem;">Ready to Start Your Project?</h2>
      <p style="color: #666; margin-bottom: 1.5rem;">Contact us today to discuss your electrical project needs and get a free consultation.</p>
      <a href="/contact" class="cta-button">Contact Us</a>
    </section>
  </div>
</Layout>
